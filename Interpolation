def give_date(days_of_month,months):
    month=""
    while month not in months:
        month=input("Please enter a valid month: ")
    full_days = max(days_of_month)

    day = 0
    while day < int(min(days_of_month)) or day >int(full_days):
        day = int(input(f"Please enter a valid day ({min(days_of_month)}-{full_days}): "))
    return month,str(day)

def transform_hours(hours):
    temp=[]
    for hour in hours:
        temp.append(int(hour[0:2]))
    return temp

def transform_temperatures(temperatures):
    temp=[]
    for tr in temperatures:
        if tr=="-":
            temp.append(0)
        else:
            temp.append(int(tr[0:2]))
    return temp

def transform_hyd(hyd):
    temp=[]
    for h in hyd:
        if h=="-":
            temp.append(0)
        else:
            temp.append(int(h[0:2]))
    return temp

