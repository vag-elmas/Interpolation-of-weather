def prwti_Barykentriking(inp,output):
    if len(inp) != len(output):
        print("Error")
        return
    n=len(inp)
    w=np.ones((n,1),dtype=float)
    x = symbols("x")
    for i in range(n):
        for j in range(n):
            if j!=i:
                w[i,0]*=1/(inp[i]-inp[j])
    l=1
    for i in range(n):
        l*=(x-inp[i])
    synartisi=(w[0,0]*output[0])/(x-inp[0])
    for i in range(1,n):
        synartisi+=(w[i,0]*output[i])/(x-inp[i])
    synartisi*=l
    return x,synartisi

