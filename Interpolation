def save_csv(file_name,df,columns):
    if ".csv" not in file_name:
        print(f"No .csv found so we cannot save the dataframe to the {file_name}!")
    else:
        file_path = Path(file_name)
        if file_path.is_file():
            dt = pd.read_csv(file_name)
            dt["ΘΕΣΗ"] = dt["ΘΕΣΗ"].astype(str).str.replace(".0", "", regex=False)
            df["ΘΕΣΗ"] = df["ΘΕΣΗ"].astype(str).str.replace(".0", "", regex=False)
            if dt.empty:
                df.to_csv(file_name,index=False)
            else:
                for col in df.columns:
                    if col not in dt.columns:
                        dt[col] = "-"
                row=[]
                for index in df.index:
                    if df["ΘΕΣΗ"][index] in dt["ΘΕΣΗ"].values:
                        continue
                    else:
                        df_t=df.loc[[index]].copy()
                        for col in df_t.columns:
                            if col not in dt:
                                dt[col]="-"
                        for col in dt.columns:
                            if col not in df_t:
                                df_t[col] = "-"
                        df_t=df_t[dt.columns]
                        row.append(df_t)
                if row:
                    new_df=pd.concat(row,ignore_index=True)
                    dt=pd.concat([dt,new_df],ignore_index=True)

                old = dt.iloc[:, :3]
                n = dt.iloc[:, 3:]
                n = n.sort_index(axis=1)
                dt = pd.concat([old, n], axis=1)

                for index, day in df.iterrows():
                    if day["ΘΕΣΗ"] in dt["ΘΕΣΗ"].values:
                        for hour in df.columns[2:]:
                            val = day[hour]
                            if isinstance(val, pd.Series):
                                val = val.iloc[-1]

                            if str(val) != "-":
                                dt.loc[dt["ΘΕΣΗ"] == day["ΘΕΣΗ"], hour] = str(val)
                dt.to_csv(file_name, index=False)
        else:
            df.to_csv(file_name,index=False)


def web_scrape(url):
    soup = get_soup(url)
    if soup:
        print(f"All good")

        pattern = re.compile(r"(\d+)")
        days = []
        for t in soup.find_all(class_="flleft")[0:7]:
            text_content = t.get_text(strip=True)
            days.append(pattern.split(text_content)[0])

        dom = []
        for t in soup.find_all(class_="dayNumbercf"):
            text_content = t.get_text(strip=True)
            dom.append(pattern.split(text_content)[1])

        months = []
        for t in soup.find_all(class_="monthNumbercf"):
            text_content = t.get_text(strip=True)
            month_match = pattern.search(text_content)
            if month_match:
                months.append(month_match.group(1))
            else:
                months.append(text_content)

        times = []
        for t in soup.find_all(class_="innerTableCell fulltime"):
            times.append(t.get_text(strip=True))

        pattern = soup.find(class_="celcius")
        celcius = pattern.text
        pattern = re.compile(celcius)
        temperatures = []
        hydrations = []
        for t in soup.find_all(class_="innerTableCell temperature tempwidth"):
            for a in t.find_all(class_="normal tempcolorcell"):
                text_content = a.get_text(strip=True)
                temperature, hyd = pattern.split(text_content, 1)
                temperature += celcius
                hyd = re.sub('υγρ.', '', hyd)
                temperatures.append(temperature)
                hydrations.append(hyd)
            for a in t.find_all(class_="kafsonas tempcolorcell"):
                text_content = a.get_text(strip=True)
                temperature, hyd = pattern.split(text_content, 1)
                temperature += celcius
                hyd = re.sub('υγρ.', '', hyd)
                temperatures.append(temperature)
                hydrations.append(hyd)
            for a in t.find_all(class_="kafsonas maxtemp tempcolorcell"):
                text_content = a.get_text(strip=True)
                temperature, hyd = pattern.split(text_content, 1)
                temperature += celcius
                hyd = re.sub('υγρ.', '', hyd)
                temperatures.append(temperature)
                hydrations.append(hyd)

        temporary = []
        for hyd in hydrations:
            match = re.search(r"(\d+)%", hyd)
            if match:
                temporary.append(match.group(1) + "%")

        hydrations = temporary.copy()
        del temporary

        pattern = re.compile(r"(\d+)")
        winds = []
        for t in soup.find_all(class_="innerTableCell anemosfull"):
            text_content = t.get_text(strip=True)
            wind = pattern.split(text_content)[1]
            wind += " Μποφορ"
            winds.append(wind)
        return days,dom,months,times,temperatures,hydrations,winds,celcius
    else:
        print(f"Something went wrong")
        return None,None,None,None,None,None,None,None

def job(url,file_name1,file_name2):
    days, dom, months, times, temperatures, hydrations, winds, celcius = web_scrape(url)
    if days != None and dom != None and months != None and times != None and temperatures != None and hydrations != None and winds != None and celcius != None:
        day_dictionary = {}
        for day in days:
            day_dictionary[day] = []

        index = 0
        for key in day_dictionary.keys():
            while True:
                if index > len(times) - 1:
                    break
                if day_dictionary[key] and day_dictionary[key][-1] == "21:00":
                    break
                day_dictionary[key].append(times[index])
                index += 1

        hours = []
        for key in day_dictionary.keys():
            if day_dictionary[key][0] == "00:00" and day_dictionary[key][-1] == "21:00":
                hours = day_dictionary[key]
                break

        days_dictionary = {}
        for day in day_dictionary.keys():
            days_dictionary[day] = []

        index = 0
        for key in day_dictionary.keys():
            for hour in hours:
                if hour not in day_dictionary[key]:
                    days_dictionary[key].append("-")
                else:
                    if index > len(temperatures) - 1:
                        days_dictionary[key].append(temperatures[-1])
                    else:
                        days_dictionary[key].append(temperatures[index])
                        index += 1
        del index

        df_temp = pd.DataFrame(days_dictionary)
        df_temp.index = hours
        df_reverse = df_temp.T
        df_temp = df_reverse
        times = []
        timestamp = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
        for i in range(len(df_temp)):
            times.append(timestamp)
        del df_reverse
        df_temp.insert(0, "ΘΕΣΗ", dom)
        df_temp.insert(1, "Μήνας", months)
        df_temp.insert(2, "ΧΡΟΝΟΣ", times)
        del timestamp, times

        index = 0
        for key in day_dictionary.keys():
            an_index = 0
            for hour in hours:
                if hour not in day_dictionary[key]:
                    days_dictionary[key][an_index] = "-"
                    an_index += 1

                else:
                    if index > len(temperatures) - 1:
                        days_dictionary[key][an_index] = hydrations[-1]
                        an_index += 1
                    else:
                        days_dictionary[key][an_index] = hydrations[index]
                        index += 1
                        an_index += 1
        del index

        df_hyd = pd.DataFrame(days_dictionary)
        del days_dictionary
        df_hyd.index = hours
        df_reverse = df_hyd.T
        df_hyd = df_reverse
        del df_reverse
        times = []
        timestamp = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
        for i in range(len(df_temp)):
            times.append(timestamp)
        df_hyd.insert(0, "ΘΕΣΗ", dom)
        df_hyd.insert(1, "Μήνας", months)
        df_hyd.insert(2, "ΧΡΟΝΟΣ", times)

        save_csv(file_name1, df_temp, hours)
        save_csv(file_name2, df_hyd, hours)
        return df_temp,df_hyd,hours,celcius

