def Newton(inp,output):
    if len(inp) != len(output):
        print("Error")
        return
    n=len(inp)
    x=symbols("x")
    times=np.ones((n,1),dtype=object)
    for i in range(1,n):
        times[i,0]=times[i-1,0]*(x-inp[i-1])
    mitrwo = np.ones((n, n), dtype=float)
    for i in range(n):
        for j in range(i+1,n):
            mitrwo[i,j]=0
        for j in range(1,i+1):
            mitrwo[i, j] = mitrwo[i, j-1] * (inp[i] - inp[j-1])
    g=np.zeros((n,1),dtype=float)
    for i in range(n):
        temp=0
        for j in range(i):
            temp+=mitrwo[i,j]*g[j,0]
        g[i,0]=(output[i]-temp)/mitrwo[i,i]
    synartisi = 0
    for i in range(n):
        synartisi += times[i, 0] * g[i, 0]

    return x,synartisi

def Newton_Enhanced(inp,output):
    if len(inp) != len(output):
        print("Error")
        return
    n=len(inp)
    x=symbols("x")
    times = np.ones((n, 1), dtype=object)
    for i in range(1, n):
        times[i, 0] = times[i - 1, 0] * (x - inp[i - 1])
    g = np.zeros((n, 1), dtype=object)
    for i in range(n):
        g[i, 0]=output[i]
    for i in range(1,n):
        for j in range(n-1,i-1,-1):
            g[j,0]=(g[j,0]-g[j-1,0])/(inp[j]-inp[j-i])
    synartisi = 0
    for i in range(n):
        synartisi += times[i, 0] * g[i, 0]
    return x,synartisi

def merge(left,right):
    t=len(left)+len(right)
    temp=[0]*t
    i,j,k=0,0,0
    while i < len(left) and j < len(right):
        if left[i]<=right[j]:
            temp[k]=left[i]
            k+=1
            i+=1
        else:
            temp[k]=right[j]
            k+=1
            j+=1

    while i<len(left):
        temp[k]=left[i]
        k+=1
        i+=1
    while j<len(right):
        temp[k]=right[j]
        k+=1
        j+=1
    return temp

def merge_sort(ar):
    if len(ar)==0 or len(ar)==1:
        return ar
    mid=len(ar)//2
    left=merge_sort([el for el in ar[:mid]])
    right=merge_sort([el for el in ar[mid:]])
    return merge(left,right)


def quick_sort(ar):
    if len(ar)==0 or len(ar)==1:
        return ar
    i,j=0,len(ar)-1
    pivot_index=(i+j)//2
    pivot=ar[pivot_index]
    while i<=j:
        while ar[i]<pivot:
            i+=1
        while ar[j]>pivot:
            j-=1
        if i<=j:
          ar[i],ar[j]=ar[j],ar[i]
          i+=1
          j-=1
    return quick_sort(ar[:i])+quick_sort(ar[i:])

