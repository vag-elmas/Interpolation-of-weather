def find_min_and_max_temp(df, choice,day):
    days = df["ΘΕΣΗ"].tolist()
    months = df["Μήνας"].tolist()
    temp = df.loc[df["ΘΕΣΗ"] == day]

    temperatures_s = []
    for hour in hours:
        temperatures_s.append(temp[hour])

    temperatures = []
    for tr in temperatures_s:
        for t in tr:
            temperatures.append(t)

    if choice == 0:
        raw_values = transform_temperatures(temperatures)
    else:
        raw_values = transform_hyd(temperatures)

    start_time_merge_sort,final_time_merge_sort,start_time_quick_sort,final_time_quick_sort=[]*10,[]*10,[]*10,[]*10
    x_merge,x_quick=0,0
    with concurrent.futures.ThreadPoolExecutor(max_workers=10) as executor:
        for _ in range(10):
            # Merge Sort Timing
            s1 = time.perf_counter()
            t1 = executor.submit(merge_sort, raw_values)
            x_merge = t1.result()
            f1 = time.perf_counter()
            start_time_merge_sort.append(s1)
            final_time_merge_sort.append(f1)

            s2 = time.perf_counter()
            t2 = executor.submit(quick_sort, raw_values)
            x_quick = t2.result()
            f2 = time.perf_counter()
            start_time_quick_sort.append(s2)
            final_time_quick_sort.append(f2)

    time_merge = np.mean(np.array(final_time_merge_sort) - np.array(start_time_merge_sort))
    time_quick = np.mean(np.array(final_time_quick_sort) - np.array(start_time_quick_sort))

    if time_quick < time_merge:
        print(f"Quick sort quicker with {time_quick} seconds")
        return str(x_quick[0]),str(x_quick[-1])
    else:
        print(f"Merge sort quicker with {time_merge} seconds")
        return str(x_merge[0]),str(x_merge[-1])


