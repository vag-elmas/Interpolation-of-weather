def get_requests(url):
    trials=0
    while trials<=5:
        try:
            req = requests.get(url)

            if req.status_code >= 200 and req.status_code <= 299:
                print(f"The status code is {req.status_code} so the request has been accepted\n")
                return req
            elif req.status_code >= 100 and req.status_code <= 199:
                print(f"The status code is {req.status_code} so the request continues under consideration\n")
            elif req.status_code >= 300 and req.status_code <= 399:
                print(f"The status code is {req.status_code} so the request is transferred to another url\n")
            elif req.status_code >= 400 and req.status_code <= 499:
                print(
                    f"The status code is {req.status_code} so you made something wrong with the request. Please try again again!\n")
            else:
                print(f"The status code is {req.status_code} so the fault is of the site\n")
        except requests.exceptions.ConnectionError:
            print(f"Connection Error with trials left {trials}\n")
        except requests.exceptions.Timeout:
            print(f"Timeout Error with trials left {trials}\n")
        trials+=1
        time.sleep(2)
    return None

def get_soup(url):
    try:
        response = get_requests(url)
        if response:
            return BeautifulSoup(response.content, "html.parser")
    except:
        print("Something went wrong\n")
    return None

def morfi_Lagrange(inp,output):
    if len(inp) != len(output):
        print("Error")
        return
    n=len(inp)
    synartiseis=np.ones((n,1),dtype=object)
    x=symbols("x")
    for i in range(n):
        for j in range(n):
            if j!=i:
                synartiseis[i,0]*=(x-inp[j])/(inp[i]-inp[j])
    synartisi=synartiseis[0,0]*output[0]
    for i in range(1,n):
        synartisi+=synartiseis[i,0]*output[i]
    return x,synartisi

